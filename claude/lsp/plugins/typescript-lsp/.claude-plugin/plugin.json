{
  "name": "typescript-lsp",
  "description": "TypeScript/JavaScript language server, pinned to one workspace's TypeScript install",
  "version": "1.0.0",
  "author": {
    "name": "<YOUR_TEAM>"
  },
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "initializationOptions": {
        "tsserver": {
          "path": "<ABSOLUTE_REPO_PATH>/<web>/node_modules/typescript/lib/tsserver.js"
        }
      },
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
